# PulseQ Platform Environment Variables Template
# Copy this file to .env.local (development) or configure via Secret Manager (staging/production)
# NEVER commit real secret values to Git!

# Environment
NODE_ENV=production
PORT=4000
ALLOWED_HOSTS=localhost,127.0.0.1,pulseq.pk,www.pulseq.pk

# SSL / TLS
FORCE_HTTPS=true

# Security & Sessions
SESSION_SECRET=change_me_to_a_cryptographically_secure_random_64_byte_hex_string
JWT_ACCESS_SECRET=change_me_to_a_cryptographically_secure_random_64_byte_hex_string
JWT_REFRESH_SECRET=change_me_to_a_cryptographically_secure_random_64_byte_hex_string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CSRF_SECRET=change_me_to_a_cryptographically_secure_random_64_byte_hex_string
COOKIE_DOMAIN=.pulseq.pk
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Password Hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Rate Limiting
GLOBAL_RATE_LIMIT_PER_MINUTE=240
API_RATE_LIMIT_PER_MINUTE=60
AUTH_OTP_RATE_LIMIT_PER_MINUTE=5

# Database (PostgreSQL / MySQL with Transactions & Connection Pooling)
DATABASE_URL=postgresql://pulseq_user:fake_password_replace_in_secret_manager@postgres.internal.pulseq.pk:5432/pulseq_prod?sslmode=verify-full
DATABASE_SSL=true
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=25

# Redis (Session Store, Rate Limiting, Slot Locks)
REDIS_URL=rediss://:fake_redis_password_replace_in_secret_manager@redis.internal.pulseq.pk:6379/0

# Private Cloud Storage (Prescriptions & Medical Reports)
# Stored outside public web root with pre-signed URLs (15-min TTL)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=pulseq-private-medical-records-prod
STORAGE_REGION=me-central-1
STORAGE_ACCESS_KEY_ID=fake_storage_access_key
STORAGE_SECRET_ACCESS_KEY=fake_storage_secret_key
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900

# SMS & OTP Provider (e.g. Twilio / Jazz / Telenor / Zong Gateway)
# Phone OTP with 5-minute expiry, max 3 verification attempts, 60-second resend cooldown
SMS_PROVIDER=gateway_pk
SMS_API_KEY=fake_sms_api_key_replace_in_secret_manager
SMS_SENDER_ID=PulseQ
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Pulse AI Assistant (DeepSeek / OpenAI / Gemini proxy via Backend Only)
AI_PROVIDER=gemini
AI_API_KEY=fake_ai_key_only_accessed_from_server_never_client
AI_RATE_LIMIT_PER_MINUTE=10
AI_FILTER_PII=true

# Security Monitoring & Audit
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=info
ALERT_WEBHOOK_URL=https://alerts.internal.pulseq.pk/webhook/security-spikes
