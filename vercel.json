{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd pulseq && npm install && npm run build",
  "outputDirectory": "pulseq/dist/pulseq/browser",
  "cleanUrls": true,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
